---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem</title>
	</head>
	<body>
		<main class="battle-page">
			<header class="hero">
				<p class="eyebrow">GitHub Contribution Battle Arena</p>
				<h1>Mona Mayhem</h1>
				<p>Choose two GitHub users and see who comes out on top.</p>
			</header>

			<form class="battle-form" id="battle-form">
				<fieldset>
					<legend>Choose your players</legend>
					<label for="player-1">Player 1</label>
					<input id="player-1" name="player-1" type="text" placeholder="octocat" required />

					<label for="player-2">Player 2</label>
					<input id="player-2" name="player-2" type="text" placeholder="torvalds" required />
				</fieldset>
				<button id="battle-button" type="submit">BATTLE!</button>
				<div class="preset-matchups" aria-label="Quick matchups">
					<span>Quick matchups:</span>
					<button type="button" class="preset-button" data-player-one="torvalds" data-player-two="gaearon">
						torvalds vs. gaearon
					</button>
					<button type="button" class="preset-button" data-player-one="octocat" data-player-two="sindresorhus">
						octocat vs. sindresorhus
					</button>
				</div>
			</form>

			<section class="status-container ready-status" id="status-container" aria-live="polite" aria-atomic="true">
				<p>INSERT COIN <span aria-hidden="true">///</span> READY PLAYER 1</p>
			</section>

			<section class="battle-stage" id="battle-stage" aria-live="assertive" hidden>
				<p class="stage-label">ROUND 01</p>
				<strong id="countdown-display">VS</strong>
				<p id="stage-caption">GET READY!</p>
			</section>

			<section class="power-hud" id="power-hud" aria-label="Player power bars" hidden>
				<div class="power-player player-one-power">
					<span data-power-name="1">PLAYER 1</span>
					<div class="power-track"><i data-power-bar="1"></i></div>
				</div>
				<div class="power-player player-two-power">
					<span data-power-name="2">PLAYER 2</span>
					<div class="power-track"><i data-power-bar="2"></i></div>
				</div>
			</section>

			<section class="scoreboard" id="scoreboard" aria-labelledby="scoreboard-title" hidden>
				<p class="eyebrow">Scoreboard</p>
				<h2 id="scoreboard-title">Battle ready</h2>
				<div class="victory-banner" id="victory-banner" hidden></div>
				<p id="score-summary"></p>
				<div class="battle-score" aria-label="Overall battle scores">
					<strong data-score="1">Player 1: 0</strong>
					<span aria-hidden="true">—</span>
					<strong data-score="2">Player 2: 0</strong>
				</div>
				<div class="comparison-table" role="table" aria-label="Battle stat comparison">
					<div class="comparison-header" role="row">
						<span role="columnheader">Stat</span>
						<span role="columnheader">Player 1</span>
						<span role="columnheader">Player 2</span>
					</div>
					<div data-comparison-rows></div>
				</div>
			</section>

			<section class="arena" id="arena" aria-label="Battle arena" hidden>
				<article class="player-card" data-player-card>
					<div class="avatar-placeholder" data-avatar aria-hidden="true">?</div>
					<p class="eyebrow">Player 1</p>
					<h2 data-username>Username</h2>
					<div class="fighter-badge" data-fighter-badge>UNKNOWN CLASS</div>
					<p class="date-range" data-date-range></p>
					<div class="contribution-grid" data-grid aria-label="Player 1 contribution grid"></div>
					<p class="placeholder" data-total>Contribution stats will appear here.</p>
				</article>

				<div class="versus" aria-hidden="true">VS</div>

				<article class="player-card" data-player-card>
					<div class="avatar-placeholder" data-avatar aria-hidden="true">?</div>
					<p class="eyebrow">Player 2</p>
					<h2 data-username>Username</h2>
					<div class="fighter-badge" data-fighter-badge>UNKNOWN CLASS</div>
					<p class="date-range" data-date-range></p>
					<div class="contribution-grid" data-grid aria-label="Player 2 contribution grid"></div>
					<p class="placeholder" data-total>Contribution stats will appear here.</p>
				</article>
			</section>
		</main>
	</body>
</html>

<script>
	import { calculateStats, parseContributionData, scoreBattle } from '../lib/battle.mjs';

	/**
	 * @typedef {{ date: string; contributionCount: number; contributionLevel: number }} ContributionDay
	 * @typedef {{ firstDay: string; days: ContributionDay[] }} ContributionWeek
	 * @typedef {{ username: string; weeks: ContributionWeek[]; days: ContributionDay[] }} ContributionData
	 */

	const form = document.querySelector('#battle-form');
	const button = document.querySelector('#battle-button');
	const statusContainer = document.querySelector('#status-container');
	const scoreboard = document.querySelector('#scoreboard');
	const scoreSummary = document.querySelector('#score-summary');
	const comparisonRows = document.querySelector('[data-comparison-rows]');
	const arena = document.querySelector('#arena');
	const battleStage = document.querySelector('#battle-stage');
	const countdownDisplay = document.querySelector('#countdown-display');
	const stageCaption = document.querySelector('#stage-caption');
	const powerHud = document.querySelector('#power-hud');
	const powerBars = {
		1: document.querySelector('[data-power-bar="1"]'),
		2: document.querySelector('[data-power-bar="2"]'),
	};
	const victoryBanner = document.querySelector('#victory-banner');
	const playerOneInput = document.querySelector('#player-1');
	const playerTwoInput = document.querySelector('#player-2');

	const setStatus = (message, isError = false) => {
		statusContainer.textContent = message;
		statusContainer.classList.toggle('error', isError);
		statusContainer.classList.toggle('ready-status', message.includes('INSERT COIN'));
	};

	const renderSkeleton = (grid) => {
		grid.replaceChildren(
			...Array.from({ length: 52 }, () => {
				const week = document.createElement('span');
				week.className = 'week-skeleton';
				week.innerHTML = '<i></i>'.repeat(7);
				return week;
			}),
		);
	};

	const renderGrid = (grid, data) => {
		grid.replaceChildren();
		return data.weeks.reduce((promise, week) => promise.then(() => {
				const weekColumn = document.createElement('span');
				weekColumn.className = 'week-column';

				for (const day of week.days) {
					const cell = document.createElement('span');
					cell.className = 'day';
					cell.dataset.level = String(day.contributionLevel);
					cell.title = `${day.date}: ${day.contributionCount} contribution${day.contributionCount === 1 ? '' : 's'}`;
					cell.setAttribute('aria-label', cell.title);
					weekColumn.append(cell);
				}

				grid.append(weekColumn);
				return new Promise((resolve) => requestAnimationFrame(resolve));
			}), Promise.resolve());
	};

	const renderPlayer = async (card, data) => {
		const avatar = card.querySelector('[data-avatar]');
		const username = card.querySelector('[data-username]');
		const fighterBadge = card.querySelector('[data-fighter-badge]');
		const dateRange = card.querySelector('[data-date-range]');
		const total = card.querySelector('[data-total]');
		const days = data.days;
		const firstDate = days[0]?.date;
		const lastDate = days[days.length - 1]?.date;

		avatar.textContent = data.username.slice(0, 1).toUpperCase();
		avatar.setAttribute('aria-label', `${data.username} avatar`);
		username.textContent = data.username;
		const fighterClass = classifyFighter(data.days);
		fighterBadge.textContent = `${fighterClass.icon} ${fighterClass.name}`;
		fighterBadge.title = fighterClass.description;
		dateRange.textContent = firstDate && lastDate ? `${firstDate} to ${lastDate}` : 'No contribution dates';
		total.textContent = `${days.reduce((sum, day) => sum + day.contributionCount, 0).toLocaleString()} total contributions`;
		await renderGrid(card.querySelector('[data-grid]'), data);
	};

	const classifyFighter = (days) => {
		const activeDays = days.filter((day) => day.contributionCount > 0);
		const weekendDays = activeDays.filter((day) => {
			const weekday = new Date(`${day.date}T00:00:00Z`).getUTCDay();
			return weekday === 0 || weekday === 6;
		});
		const weekendRatio = activeDays.length ? weekendDays.length / activeDays.length : 0;
		const peak = days.reduce((highest, day) => Math.max(highest, day.contributionCount), 0);
		const total = days.reduce((sum, day) => sum + day.contributionCount, 0);
		const averageActiveDay = activeDays.length ? total / activeDays.length : 0;
		const stats = calculateStats(days);

		if (stats.longestStreak > 30) {
			return { name: 'Streak Paladin', icon: '🛡️', description: 'A relentless 30+ day contribution streak.' };
		}

		if (weekendRatio >= 0.4) {
			return { name: 'Weekend Warrior', icon: '⚔️', description: 'Most active when the weekend begins.' };
		}

		if (peak >= Math.max(10, averageActiveDay * 3)) {
			return { name: 'Commit Berserker', icon: '🔥', description: 'Explosive power concentrated into a peak day.' };
		}

		return { name: 'Night Owl Necromancer', icon: '🌙', description: 'Raises steady activity from the quiet weekdays.' };
	};

	const wait = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

	const runCountdown = async () => {
		battleStage.hidden = false;
		const beats = [
			['3', 'LOCK ON'],
			['2', 'CHARGE UP'],
			['1', 'FINAL ROUND'],
			['FIGHT!', 'MAYHEM!'],
		];

		for (const [display, caption] of beats) {
			countdownDisplay.textContent = display;
			stageCaption.textContent = caption;
			battleStage.classList.remove('stage-hit');
			void battleStage.offsetWidth;
			battleStage.classList.add('stage-hit');
			await wait(display === 'FIGHT!' ? 500 : 650);
		}

		battleStage.hidden = true;
	};

	const updatePowerBars = (firstScore, secondScore, revealedCategories) => {
		powerBars[1].style.width = `${Math.max(8, (firstScore / 5) * 100)}%`;
		powerBars[2].style.width = `${Math.max(8, (secondScore / 5) * 100)}%`;
		powerBars[1].setAttribute('aria-valuenow', String(firstScore));
		powerBars[2].setAttribute('aria-valuenow', String(secondScore));
		powerHud.dataset.revealed = String(revealedCategories);
	};

	const formatStatValue = (key, stats) => {
		const values = {
			total: stats.total.toLocaleString(),
			longestStreak: `${stats.longestStreak} days`,
			currentStreak: `${stats.currentStreak} days`,
			peak: `${stats.peakCount.toLocaleString()} on ${stats.peakDate}`,
			consistency: `${stats.consistency}%`,
		};

		return values[key];
	};

	const renderComparison = async (first, second, firstStats, secondStats) => {
		const categories = [
			['total', 'Total Contributions'],
			['longestStreak', 'Longest Streak'],
			['currentStreak', 'Current Streak'],
			['peak', 'Most Active Day'],
			['consistency', 'Consistency Score'],
		];
		comparisonRows.replaceChildren();
		for (const [key, label] of categories) {
				const firstValue = firstStats[key === 'peak' ? 'peakCount' : key];
				const secondValue = secondStats[key === 'peak' ? 'peakCount' : key];
				const firstWins = firstValue > secondValue;
				const secondWins = secondValue > firstValue;

				const row = document.createElement('div');
				row.className = 'comparison-row';
				row.setAttribute('role', 'row');
				row.innerHTML = `
					<span role="rowheader">${label}</span>
					<strong class="${firstWins ? 'stat-winner' : ''}" role="cell">${formatStatValue(key, firstStats)}</strong>
					<strong class="${secondWins ? 'stat-winner' : ''}" role="cell">${formatStatValue(key, secondStats)}</strong>
				`;
				row.hidden = true;
				comparisonRows.append(row);
				await wait(400);
				row.hidden = false;
				row.classList.add('stat-reveal');
				updatePowerBars(firstScore, secondScore, comparisonRows.children.length);
		}

		const scores = scoreBattle(firstStats, secondStats);
		document.querySelector('[data-score="1"]').textContent = `${first.username}: ${scores.firstScore} / 5`;
		document.querySelector('[data-score="2"]').textContent = `${second.username}: ${scores.secondScore} / 5`;
		return scores;
	};

	const showVictory = (winner) => {
		victoryBanner.hidden = false;
		victoryBanner.textContent = winner === 'tie' ? 'K.O. DRAW!' : `VICTORY! ${winner}`;
		scoreboard.classList.add('final-battle');
		const particles = Array.from({ length: 18 }, (_, index) => {
			const particle = document.createElement('i');
			particle.className = 'particle';
			particle.style.setProperty('--particle-angle', `${index * 20}deg`);
			return particle;
		});
		scoreboard.append(...particles);
	};

	/**
	 * @param {string} username
	 * @returns {Promise<ContributionData>}
	 */
	const fetchContributions = async (username) => {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const payload = await response.json();

		if (!response.ok) {
			throw new Error(response.status === 404 ? `${username} was not found on GitHub.` : payload.error || `Unable to load ${username}.`);
		}

		return parseContributionData(payload, username);
	};

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const usernames = [
			document.querySelector('#player-1').value.trim(),
			document.querySelector('#player-2').value.trim(),
		];

		if (!usernames[0] || !usernames[1]) {
			setStatus('Enter both GitHub usernames before starting the battle.', true);
			return;
		}

		const url = new URL(window.location.href);
		url.searchParams.set('p1', usernames[0]);
		url.searchParams.set('p2', usernames[1]);
		window.history.replaceState({}, '', url);

		button.disabled = true;
		scoreboard.hidden = true;
		victoryBanner.hidden = true;
		scoreboard.classList.remove('final-battle');
		scoreboard.querySelectorAll('.particle').forEach((particle) => particle.remove());
		powerHud.hidden = false;
		updatePowerBars(0, 0, 0);
		arena.hidden = false;
		setStatus('LOADING FIGHT DATA...');
		document.querySelectorAll('[data-player-card]').forEach((card) => {
			renderSkeleton(card.querySelector('[data-grid]'));
		});

		try {
			const [playerOne, playerTwo] = await Promise.all([
				Promise.all(usernames.map(fetchContributions)),
				runCountdown(),
			]).then(([players]) => players);
			const cards = document.querySelectorAll('[data-player-card]');
			setStatus('REPLAYING CONTRIBUTION DATA...');
			await Promise.all([renderPlayer(cards[0], playerOne), renderPlayer(cards[1], playerTwo)]);

			const firstStats = calculateStats(playerOne.days);
			const secondStats = calculateStats(playerTwo.days);
			const scores = await renderComparison(playerOne, playerTwo, firstStats, secondStats);
			const result = scores.firstScore === scores.secondScore
				? "It's a tie!"
				: `${scores.firstScore > scores.secondScore ? playerOne.username : playerTwo.username} wins!`;

			scoreboard.querySelector('h2').textContent = result;
			scoreSummary.textContent = 'Each category is worth one battle point. Tied categories award half a point to each player.';
			scoreboard.hidden = false;
			showVictory(scores.firstScore === scores.secondScore ? 'tie' : scores.firstScore > scores.secondScore ? playerOne.username : playerTwo.username);
			setStatus('Battle loaded.');
		} catch (error) {
			arena.hidden = true;
			setStatus(error instanceof Error ? error.message : 'The battle could not be loaded.', true);
		} finally {
			button.disabled = false;
		}
	});

	document.querySelectorAll('[data-player-one][data-player-two]').forEach((preset) => {
		preset.addEventListener('click', () => {
			playerOneInput.value = preset.dataset.playerOne;
			playerTwoInput.value = preset.dataset.playerTwo;
			form.requestSubmit();
		});
	});

	const sharedBattle = new URLSearchParams(window.location.search);
	const sharedPlayerOne = sharedBattle.get('p1');
	const sharedPlayerTwo = sharedBattle.get('p2');

	if (sharedPlayerOne && sharedPlayerTwo) {
		playerOneInput.value = sharedPlayerOne;
		playerTwoInput.value = sharedPlayerTwo;
		form.requestSubmit();
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		--cabinet: #0a0a12;
		--panel: #111322;
		--panel-bright: #1b1d35;
		--line: #34365e;
		--cyan: #45f7e0;
		--green: #5fed83;
		--magenta: #ff3cac;
		--gold: #ffd166;
		--ink: #f7f4ea;
		margin: 0;
		background: var(--cabinet);
		color: var(--ink);
		font-family: "JetBrains Mono", monospace;
	}

	:global(body::before),
	:global(body::after) {
		position: fixed;
		z-index: 20;
		pointer-events: none;
		content: "";
	}

	:global(body::before) {
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			rgb(255 255 255 / 0.035) 0,
			rgb(255 255 255 / 0.035) 1px,
			transparent 1px,
			transparent 4px
		);
		mix-blend-mode: screen;
		opacity: 0.45;
	}

	:global(body::after) {
		inset: 0;
		background: radial-gradient(ellipse at center, transparent 48%, rgb(0 0 0 / 0.68) 100%);
	}

	.battle-page {
		position: relative;
		z-index: 1;
		width: min(1100px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 3rem 0;
	}

	.hero,
	.battle-form,
	.status-container,
	.scoreboard {
		text-align: center;
	}

	.hero {
		margin-bottom: 2rem;
		animation: float-in 0.8s ease both;
	}

	h1 {
		margin: 0.5rem 0;
		color: var(--magenta);
		font-family: "Press Start 2P", monospace;
		font-size: clamp(2rem, 7vw, 4.5rem);
		line-height: 1.25;
		text-shadow: 0 0 8px var(--magenta), 0 0 24px rgb(255 60 172 / 0.65), 4px 4px 0 #5c1f74;
		animation: neon-pulse 3s ease-in-out infinite;
	}

	h2 {
		font-family: "Press Start 2P", monospace;
		font-size: 1rem;
		line-height: 1.6;
		margin: 0.5rem 0 1rem;
	}

	.eyebrow {
		margin: 0;
		color: var(--gold);
		font-family: "Press Start 2P", monospace;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-shadow: 0 0 8px rgb(255 209 102 / 0.8);
	}

	.battle-form {
		margin-bottom: 1.5rem;
	}

	fieldset {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
	}

	legend {
		width: 100%;
		margin-bottom: 0.25rem;
		font-family: "Press Start 2P", monospace;
		font-size: 0.7rem;
		font-weight: 700;
	}

	label {
		align-self: center;
	}

	input {
		width: 12rem;
		padding: 0.65rem;
		border: 2px solid var(--cyan);
		border-radius: 0;
		background: #090b16;
		color: inherit;
		font: inherit;
		box-shadow: 0 0 8px rgb(69 247 224 / 0.25), inset 0 0 10px rgb(69 247 224 / 0.08);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	input:focus {
		transform: translateY(-2px);
		box-shadow: 0 0 12px var(--cyan), 0 0 28px rgb(69 247 224 / 0.35), inset 0 0 12px rgb(69 247 224 / 0.12);
		outline: none;
	}

	button {
		padding: 0.7rem 1.2rem;
		border: 2px solid var(--gold);
		border-radius: 0;
		background: var(--magenta);
		color: #16091a;
		cursor: pointer;
		font-family: "Press Start 2P", monospace;
		font-size: 0.72rem;
		font-weight: 800;
		box-shadow: 0 0 10px rgb(255 60 172 / 0.65);
		text-shadow: 1px 1px 0 rgb(255 255 255 / 0.25);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	button:hover:not(:disabled) {
		transform: translateY(-2px) scale(1.02);
		box-shadow: 0 0 16px var(--magenta), 0 0 34px rgb(255 60 172 / 0.35);
	}

	.preset-matchups {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
		color: #8588ad;
		font-size: 0.85rem;
	}

	.preset-button {
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--line);
		background: var(--panel);
		color: #c9c8d8;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.preset-button:hover {
		border-color: var(--gold);
		color: #fff;
		box-shadow: 0 0 10px rgb(255 209 102 / 0.35);
	}

	.status-container,
	.scoreboard {
		margin: 1rem 0;
		padding: 1rem;
		border: 2px solid var(--line);
		border-radius: 0;
		background: var(--panel);
		box-shadow: 0 0 12px rgb(52 54 94 / 0.4), inset 0 0 18px rgb(0 0 0 / 0.3);
	}

	.status-container p,
	.scoreboard p:last-child,
	.placeholder {
		margin-bottom: 0;
		color: #a7a8bc;
	}

	.status-container.error {
		border-color: #ff5c7a;
		color: #ff8a8a;
		text-shadow: 0 0 8px rgb(255 92 122 / 0.6);
	}

	.ready-status {
		border-color: var(--green);
		color: var(--green);
		font-family: "Press Start 2P", monospace;
		font-size: 0.7rem;
		text-shadow: 0 0 8px var(--green), 0 0 18px rgb(95 237 131 / 0.6);
		animation: blink 1.1s steps(2, start) infinite;
	}

	.ready-status p {
		color: inherit;
	}

	.battle-stage {
		position: relative;
		margin: 1.5rem 0;
		padding: 1.5rem;
		border: 3px solid var(--gold);
		background: #090a16;
		box-shadow: 0 0 18px rgb(255 209 102 / 0.55), inset 0 0 20px rgb(255 60 172 / 0.18);
		text-align: center;
	}

	.stage-label,
	#stage-caption {
